# Frankonia CyberShield — deployment environment
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored,
# so credentials stay on your machine only. `deploy/upload.py` and
# `deploy/deploy.py` load it automatically.

# --- SFTP target (frankonia-cybershield.com document root) ---
SFTP_HOST=
SFTP_USER=
SFTP_PASS=
SFTP_REMOTE=/cybershield

# --- Production build ---
# These are consumed by `next build` when running `deploy/deploy.py`.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_ORIGIN=https://www.frankonia-cybershield.com
NEXT_PUBLIC_INDEXABLE=1
